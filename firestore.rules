rules_version = '2';

// Rules for the whole Firebase project: Mise and Tandem share it.
// Deploy: paste into Firebase console -> Firestore -> Rules, or
//   npx firebase-tools deploy --only firestore:rules --project <project-id>
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Mise ──────────────────────────────────────────────────────────────
    // Only the shared Mise account, and only its own data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && userId == "OY6CbOwlq9aXV5tiJ6FdDdSYMB12";
    }

    // ── Tandem ────────────────────────────────────────────────────────────
    // Only our two personal accounts. Anyone can create a Firebase account
    // with the public web config, so being signed in is not enough.
    function signedIn() {
      return request.auth != null
        && request.auth.uid in ["NTMWruQo2AYj4bWBvVPxwnPeA8u1", "Bo4TkhRHmcXowr2l1DnfEU5WaJq1"];
    }

    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Starting a household: you are its only member.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['name', 'members', 'member_names']);

      // Members may edit it but not change who's in it. Someone holding the
      // household code (its id) may join a household of one, adding only themself.
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
        || (resource.data.members.size() == 1
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'member_names']))
      );

      // Shared tasks: any member. Personal tasks: their owner only, so a
      // personal list stays private from the other person.
      match /tasks/{tid} {
        function canSee(d) {
          return d.list == 'shared' || d.owner_uid == request.auth.uid;
        }

        allow read, delete: if isMember(hid) && canSee(resource.data);
        allow create: if isMember(hid) && canSee(request.resource.data);
        allow update: if isMember(hid) && canSee(resource.data) && canSee(request.resource.data);
      }
    }
  }
}
