/**
 * Priorities' MCP server: lets each of our Claude accounts read and update Priorities.
 * Setup and deploy: see README.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "priorities-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  /**
   * Secret (never in this file): FIREBASE_SERVICE_ACCOUNT, the service-account
   * key JSON. Set it with `npx wrangler secret put FIREBASE_SERVICE_ACCOUNT < key.json`.
   */
  "vars": {
    // Same Firebase project as the apps. Neither value is secret: both ship in the apps' web config.
    "FIREBASE_PROJECT_ID": "<firebase-project-id>",
    "FIREBASE_API_KEY": "<firebase-web-api-key>",
    // The two Priorities accounts (must match firestore.rules).
    "ALLOWED_UIDS": "NTMWruQo2AYj4bWBvVPxwnPeA8u1,Bo4TkhRHmcXowr2l1DnfEU5WaJq1",
    // "Today" and "this week" are counted in this time zone.
    "TIMEZONE": "America/Los_Angeles"
  },
  "migrations": [{ "new_sqlite_classes": ["PrioritiesMCP"], "tag": "v1" }],
  "durable_objects": {
    "bindings": [{ "class_name": "PrioritiesMCP", "name": "MCP_OBJECT" }]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // From `npx wrangler kv namespace create OAUTH_KV` (not a secret).
      "id": "<Add-KV-ID>"
    }
  ],
  "observability": { "enabled": true },
  "dev": { "port": 8789 }
}
